{
  "manifest_version": 3,
  "name": "Life Planner Connector",
  "version": "1.2.1",
  "description": "Sends your myWestbourne due work and news, Teams assignments, and Strava and Garmin activities, sleep and steps into your Life Planner.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Life Planner Connector" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://my.westbourne.vic.edu.au/*",
    "https://www.strava.com/*",
    "https://connect.garmin.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://assignments.onenote.com/*",
    "http://127.0.0.1:47823/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://my.westbourne.vic.edu.au/*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.strava.com/*", "https://connect.garmin.com/*", "https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://assignments.onenote.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["https://www.strava.com/*", "https://connect.garmin.com/*", "https://teams.microsoft.com/*", "https://teams.cloud.microsoft/*", "https://assignments.onenote.com/*"],
      "js": ["sites.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
